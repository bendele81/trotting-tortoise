---
interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}
const {
  title = "Trotting Tortoise · Set your land speed record.",
  description = "Shirts with a QR code that shows your 5K, 10K, half and full marathon times.",
  noindex = false,
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=Montserrat:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --bg: #dfe1dd;
    --card: #eceeea;
    --ink: #262925;
    --muted: #5d615b;
    --line: #b4b9b1;
    --accent: #3d6a37;
    --on-accent: #fff;
    --sans: "Montserrat", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    --num: "Barlow Condensed", "Arial Narrow", Impact, sans-serif;
    color-scheme: light;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #1a1c19;
      --card: #242722;
      --ink: #e9ebe6;
      --muted: #9ba097;
      --line: #3b3f38;
      --accent: #93c783;
      --on-accent: #14200f;
      color-scheme: dark;
    }
  }
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  html {
    height: 100%;
  }
  body {
    margin: 0;
    min-height: 100%;
    background: var(--bg);
    color: var(--ink);
    font-family: var(--sans);
    line-height: 1.45;
    -webkit-text-size-adjust: 100%;
    padding-top: env(safe-area-inset-top, 0px);
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font: 600 0.9rem var(--sans);
    border-radius: 999px;
    padding: 0.75rem 1.25rem;
    border: 2px solid var(--ink);
    color: var(--ink);
    background: transparent;
    text-decoration: none;
    cursor: pointer;
    min-height: 2.75rem;
  }
  .btn.primary {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
  }
  .btn[aria-disabled="true"] {
    opacity: 0.6;
    cursor: default;
  }
  .btn:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 3px;
  }
  .demo-tag {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.2rem 0.65rem;
  }
</style>
