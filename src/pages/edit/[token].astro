---
// The private edit page. The long code in the address is the key: it's signed, so it can't be guessed or forged.
export const prerender = false;

import Base from "../../layouts/Base.astro";
import Mark from "../../components/Mark.astro";
import { DISTANCES } from "../../data/runners";
import type { Distance } from "../../data/runners";
import { getEditSecret } from "../../lib/token";
import { verifyToken } from "../../lib/token-core";
import { getRunnerForEdit, updateTimes, softDeleteRunner } from "../../lib/db";
import { parseTime } from "../../lib/time";
import { fmtTime } from "../../lib/format";
import { DEMO, DEMO_EDITABLE } from "../../config";

// Keep the secret link out of caches, search engines and "referrer" headers.
Astro.response.headers.set("Cache-Control", "no-store");
Astro.response.headers.set("Referrer-Policy", "no-referrer");
Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");

type View = "form" | "invalid" | "unavailable" | "deleted";
let view: View = "form";
let username = "";
const values: Record<Distance, string> = { "5K": "", "10K": "", Half: "", Full: "" };
const errors: Partial<Record<Distance, string>> = {};
let formError = "";
let isDemoRunner = false;
const saved = Astro.url.searchParams.get("saved") === "1";

const secret = getEditSecret();
if (!secret) {
  view = "unavailable";
  Astro.response.status = 503;
} else {
  const claim = await verifyToken(secret, Astro.params.token ?? "");
  if (!claim) {
    view = "invalid";
    Astro.response.status = 404;
  } else {
    try {
      const row = await getRunnerForEdit(claim.u);
      if (!row || row.deleted || row.linkVersion !== claim.v) {
        view = "invalid";
        Astro.response.status = 404;
      } else {
        username = row.username;
        // Demo runners can be edited by anyone, so they can never be deleted.
        isDemoRunner = DEMO && DEMO_EDITABLE.includes(username);
        for (const d of DISTANCES) {
          const sec = row.times[d];
          values[d] = sec === null ? "" : fmtTime(sec);
        }

        if (Astro.request.method === "POST") {
          const form = await Astro.request.formData();
          if (form.get("action") === "delete" && !isDemoRunner) {
            if (form.get("confirm") === "yes") {
              await softDeleteRunner(username);
              view = "deleted";
            } else {
              formError = "Tick the box to confirm you want to delete your page.";
            }
          } else {
            const parsed: Record<Distance, number | null> = { "5K": null, "10K": null, Half: null, Full: null };
            for (const d of DISTANCES) {
              const raw = String(form.get(d) ?? "");
              values[d] = raw;
              const result = parseTime(d, raw);
              if (result.ok) parsed[d] = result.value;
              else errors[d] = result.error;
            }
            if (Object.keys(errors).length === 0) {
              await updateTimes(username, parsed);
              return Astro.redirect(Astro.url.pathname + "?saved=1", 303);
            }
          }
        }
      }
    } catch (err) {
      console.error("Edit page failed", err);
      view = "unavailable";
      Astro.response.status = 503;
    }
  }
}

const hasErrors = Object.keys(errors).length > 0;
---
<Base title="Edit your times · Trotting Tortoise" noindex>
  <main>
    <a href="/" class="home" aria-label="Trotting Tortoise home"><Mark class="mark" /></a>

    {
      view === "form" && (
        <>
          <h1 class="title">Your times</h1>
          <p class="sub">
            Editing <strong>{username}</strong> · <a href={`/${username}`}>View your page</a>
          </p>

          {saved && !hasErrors && <p class="note ok" role="status">Saved. Your page is updated.</p>}
          {hasErrors && <p class="note bad" role="alert">Some times need a fix. Nothing was saved yet.</p>}

          <form method="post" class="card" novalidate>
            <input type="hidden" name="action" value="save" />
            {DISTANCES.map((d) => (
              <div class="field">
                <label for={`t-${d}`}>{d}</label>
                <div class="inputs">
                  <input
                    id={`t-${d}`}
                    name={d}
                    type="text"
                    inputmode="text"
                    autocomplete="off"
                    autocapitalize="none"
                    spellcheck="false"
                    placeholder="not run yet"
                    value={values[d]}
                    aria-invalid={errors[d] ? "true" : undefined}
                    aria-describedby={errors[d] ? `e-${d}` : undefined}
                  />
                  {errors[d] && <p class="err" id={`e-${d}`}>{errors[d]}</p>}
                </div>
              </div>
            ))}
            <p class="hint">Enter minutes:seconds (22:41) or hours:minutes:seconds (1:46:05). Leave a box empty if you haven't run that distance yet.</p>
            <button class="btn primary" type="submit">Save my times</button>
          </form>

          {!isDemoRunner && (
          <details class="danger" open={formError ? true : undefined}>
            <summary>Delete my page</summary>
            <p>
              This removes your times and hides your page. Your username stays reserved, so nobody else can take it and the QR code on your shirt will never show someone else's page.
            </p>
            <form method="post">
              <input type="hidden" name="action" value="delete" />
              <label class="check">
                <input type="checkbox" name="confirm" value="yes" /> Yes, delete my page
              </label>
              {formError && <p class="err" role="alert">{formError}</p>}
              <button class="btn" type="submit">Delete my page</button>
            </form>
          </details>
          )}
          {isDemoRunner && <p class="hint">This is a demo page, so anyone can edit it and it can't be deleted.</p>}
        </>
      )
    }

    {
      view === "invalid" && (
        <>
          <h1 class="title">This link isn't valid</h1>
          <p class="sub">It may have been replaced by a newer one, or it was copied wrong. Check your email for the latest link.</p>
          <div class="foot"><a class="btn primary" href="/">Back to home</a></div>
        </>
      )
    }

    {
      view === "unavailable" && (
        <>
          <h1 class="title">Try again</h1>
          <p class="sub">Editing isn't available right now. Please try again in a moment.</p>
          <div class="foot"><a class="btn primary" href="/">Back to home</a></div>
        </>
      )
    }

    {
      view === "deleted" && (
        <>
          <h1 class="title">Page deleted</h1>
          <p class="sub">Your times are gone and your page is hidden. Your username stays reserved.</p>
          <div class="foot"><a class="btn primary" href="/">Back to home</a></div>
        </>
      )
    }
  </main>
</Base>

<style>
  main {
    max-width: 30rem;
    margin: 0 auto;
    padding: 1.75rem 1.25rem 3rem;
  }
  .home {
    display: block;
    width: min(12rem, 60%);
    margin: 0 0 1.25rem;
    color: var(--muted);
  }
  .mark {
    display: block;
    width: 100%;
    height: auto;
  }
  .title {
    font-family: var(--num);
    font-weight: 700;
    font-size: 3rem;
    line-height: 0.95;
    margin: 0;
    overflow-wrap: anywhere;
  }
  .sub {
    margin: 0.75rem 0 0;
    color: var(--muted);
    overflow-wrap: anywhere;
  }
  .sub strong,
  .sub a {
    color: var(--ink);
  }
  .note {
    margin: 1.25rem 0 0;
    padding: 0.75rem 1rem;
    border-radius: 0.6rem;
    font-weight: 600;
    font-size: 0.9rem;
  }
  .note.ok {
    background: var(--accent);
    color: var(--on-accent);
  }
  .note.bad {
    border: 2px solid var(--ink);
  }
  .card {
    background: var(--card);
    border-radius: 0.75rem;
    margin: 1.5rem 0 0;
    padding: 0.5rem 1.1rem 1.25rem;
  }
  .field {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr);
    gap: 0 0.75rem;
    align-items: start;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--line);
  }
  .field label {
    font-family: var(--num);
    font-weight: 700;
    font-size: 1.9rem;
    line-height: 2.75rem;
    color: var(--muted);
  }
  .inputs {
    min-width: 0;
  }
  .inputs input {
    width: 100%;
    min-height: 2.75rem;
    border: 2px solid var(--line);
    border-radius: 0.5rem;
    background: transparent;
    color: var(--ink);
    font: 600 1.1rem var(--sans);
    padding: 0.4rem 0.75rem;
  }
  .inputs input:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 2px;
    border-color: var(--ink);
  }
  .inputs input[aria-invalid="true"] {
    border-color: var(--ink);
  }
  .err {
    margin: 0.4rem 0 0;
    font-size: 0.82rem;
    font-weight: 600;
  }
  .hint {
    margin: 1rem 0 1.1rem;
    font-size: 0.82rem;
    color: var(--muted);
  }
  .danger {
    margin: 2rem 0 0;
    border-top: 1px solid var(--line);
    padding-top: 1rem;
  }
  .danger summary {
    cursor: pointer;
    font-weight: 600;
    font-size: 0.9rem;
    min-height: 2.75rem;
    display: flex;
    align-items: center;
  }
  .danger p {
    font-size: 0.85rem;
    color: var(--muted);
    margin: 0.25rem 0 1rem;
  }
  .check {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.9rem;
    font-weight: 600;
    min-height: 2.75rem;
  }
  .check input {
    width: 1.25rem;
    height: 1.25rem;
  }
  .foot {
    margin: 1.75rem 0 0;
  }
</style>
